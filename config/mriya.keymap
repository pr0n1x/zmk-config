#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                    &kp GRAVE   &kp N1  &kp N2    &kp N3     &kp N4           &kp N5          &kp N6        &kp N7  &kp N8      &kp N9    &kp N0    &kp MINUS
&mt LCTRL CAPSLOCK  &kp TAB     &kp Q   &kp W     &kp E      &kp R            &kp T           &kp Y         &kp U   &kp I       &kp O     &kp P     &kp LEFT_BRACKET  &mt RCTRL RBKT
                    &kp LSHIFT  &kp A   &kp S     &kp D      &kp F            &kp G           &kp H         &kp J   &kp K       &kp L     &kp SEMI  &kp SQT
                    &kp LGUI    &kp Z   &kp X     &kp C      &kp V            &kp B           &kp N         &kp M   &kp COMMA   &kp DOT   &kp FSLH  &kp RGUI
                                        &kp LALT  &kp LCTRL  &mt LSHFT SPACE  &lt 1 ESCAPE    &lt 1 RETURN  &mo 2   &kp RSHIFT  &kp RALT
            >;
        };

        lower_layer {
            bindings = <
        &kp LG(GRAVE)  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp F5    &kp F6       &kp F7     &kp F8         &kp C_PLAY_PAUSE  &kp PRINTSCREEN       &kp SCROLLLOCK         &kp PAUSE_BREAK
&trans  &trans         &kp F1      &kp F2             &kp F3           &kp F4    &kp EQUAL    &kp MINUS  &kp F9         &kp F10           &kp F11               &kp F12                &kp CARET        &trans
        &trans         &kp EXCL    &kp AT             &kp HASH         &kp DLLR  &kp PRCNT    &kp PIPE   &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS
        &trans         &kp N1      &kp N2             &kp N3           &kp N4    &kp N5       &kp N6     &kp N7         &kp N8            &kp N9                &kp N0                 &trans
                                   &trans             &trans           &trans    &trans       &trans     &none          &trans            &trans
            >;
        };

        raise_layer {
            bindings = <
             &none   &none            &none      &kp KP_DIVIDE  &kp KP_ASTERISK  &kp KP_NUM              &kp EQUAL           &kp INSERT  &kp DELETE    &kp C_PLAY_PAUSE  &kp C_PREV     &kp C_NEXT
&kp C_POWER  &none   &kp KP_SLASH     &kp KP_N7  &kp KP_N8      &kp KP_N9        &kp KP_MINUS            &kp UNDER           &kp HOME    &kp END       &kp BACKSPACE     &kp PAGE_UP    &kp BACKSLASH      &kp RIGHT_SHIFT
             &trans  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5      &kp KP_N6        &kp KP_PLUS             &kp RSHIFT          &kp LBKT    &kp UP        &kp RBKT          &kp PAGE_DOWN  &kp RIGHT_CONTROL
             &trans  &kp KP_N0        &kp KP_N1  &kp KP_N2      &kp KP_N3        &kp KP_DOT              &kp RCTRL           &kp LEFT    &kp DOWN      &kp RIGHT         &kp RIGHT_ALT  &kp RMETA
                                      &trans     &trans         &kp KP_DOT       &lt (3) RS(KP_ENTER)    &kp K_CONTEXT_MENU  &trans      &kp C_VOL_DN  &kp C_VOLUME_UP
            >;
        };

        adjust_layer {
            bindings = <
       &none        &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };
    };
};
