#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
              &kp GRAVE       &kp N1  &kp N2    &kp N3        &kp N4           &kp N5          &kp N6       &kp N7  &kp N8      &kp N9                       &kp N0    &kp MINUS
&kp CAPSLOCK  &kp TAB         &kp Q   &kp W     &kp E         &kp R            &kp T           &kp Y        &kp U   &kp I       &kp O                        &kp P     &kp EQUAL          &mt RWIN LEFT_BRACKET
              &kp LEFT_SHIFT  &kp A   &kp S     &kp D         &kp F            &kp G           &kp H        &kp J   &kp K       &kp L                        &kp SEMI  &kp SQT
              &kp LCTRL       &kp Z   &kp X     &kp C         &kp V            &kp B           &kp N        &kp M   &kp COMMA   &kp DOT                      &kp FSLH  &kp RIGHT_CONTROL
                                      &kp LGUI  &kp LEFT_ALT  &mt LSHFT SPACE  &lt 1 ESCAPE    &lt 1 ENTER  &mo 2   &kp RSHIFT  &mt RIGHT_ALT RIGHT_BRACKET
            >;
        };

        lower_layer {
            bindings = <
        &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PIPE  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK
&trans  &trans  &kp F1            &kp F2             &kp F3    &kp F4          &kp F5             &kp F6             &kp F7           &kp F8            &kp F9           &kp F10         &kp F11          &mt RGUI F12
        &trans  &kp EXCL          &kp AT             &kp HASH  &kp DLLR        &kp PRCNT          &kp CARET          &kp AMPS         &kp STAR          &kp LPAR         &kp RPAR        &kp UNDERSCORE
        &trans  &kp N1            &kp N2             &kp N3    &kp N4          &kp N5             &kp N6             &kp N7           &kp N8            &kp N9           &kp N0          &kp PLUS
                                  &trans             &trans    &trans          &trans             &trans             &none            &trans            &trans
            >;
        };

        raise_layer {
            bindings = <
        &kp C_POWER  &none            &none      &kp KP_DIVIDE  &kp KP_ASTERISK  &kp KP_NUM              &kp BACKSPACE       &kp INS           &kp C_PP           &kp C_PREVIOUS   &kp C_NEXT     &kp C_MUTE
&trans  &kp KP_NUM   &kp KP_SLASH     &kp KP_N7  &kp KP_N8      &kp KP_N9        &kp KP_MINUS            &kp DELETE          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSPACE    &kp PAGE_UP    &kp BACKSLASH    &kp RWIN
        &trans       &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5      &kp KP_N6        &kp KP_PLUS             &kp RSHIFT          &kp HOME          &kp UP             &kp END          &kp PAGE_DOWN  &kp RIGHT_SHIFT
        &trans       &kp KP_N0        &kp KP_N1  &kp KP_N2      &kp KP_N3        &kp KP_DOT              &kp RCTRL           &kp LEFT_ARROW    &kp DOWN           &kp RIGHT_ARROW  &kp RIGHT_ALT  &kp RMETA
                                      &trans     &trans         &kp KP_DOT       &lt (3) RS(KP_ENTER)    &kp K_CONTEXT_MENU  &trans            &kp C_VOL_DN       &kp C_VOLUME_UP
            >;
        };

        adjust_layer {
            bindings = <
       &none        &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };
    };
};
